# URL-encode special characters in the password (e.g. & → %26).
# Copy the CURRENT string from Supabase: Project → Settings → Database → Session pooler (port 5432).
# User must be postgres.YOUR_PROJECT_REF (not plain "postgres") on the shared pooler host.
# If you see "tenant/user ... not found", the project is paused, deleted, or the URI is outdated.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Backend server
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (server-side). Create a Service Account JSON in Firebase Console.
# Option A (recommended): path to JSON file (do NOT commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# Option B: paste JSON content into a single line (escape newlines) - not recommended
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Auto Trader Connect (sandbox by default)
AUTOTRADER_ENV=sandbox
AUTOTRADER_KEY=your_sandbox_key
AUTOTRADER_SECRET=your_sandbox_secret
AUTOTRADER_ADVERTISER_ID=your_advertiser_id
